# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# --- brain (headless Claude Code) ---
# Override if you need to pin a model or add flags, e.g.:
# BRAIN_CMD=claude -p --output-format text --model claude-sonnet-5
BRAIN_CMD=claude -p --output-format text

# --- telegram surface + receipts delivery ---
# Create a bot via @BotFather, then run `python3 -m surfaces.telegram_bot`
# once and message it — it will print your chat id to fill in below.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- email actions (brain/emailer.py) ---
# Gmail: create an app password at https://myaccount.google.com/apppasswords
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
IMAP_HOST=imap.gmail.com

# --- phone line (calls/runner.py) ---
# stub   = simulated line, you play the callee at the keyboard (default)
# twilio = real outbound calls via Twilio Programmable Voice
PHONE_ADAPTER=stub

# Required when PHONE_ADAPTER=twilio. Get an Account SID + Auth Token
# from the Twilio console, and a phone number capable of voice calls.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Twilio drives the call by POSTing to a webhook server that runs
# alongside calls/runner.py (surfaces/phone/twilio_server.py, started
# automatically). That server must be reachable from the public
# internet. Easiest: `ngrok http 8080`, then paste the https URL it
# prints here (no trailing slash).
TWILIO_WEBHOOK_BASE_URL=
TWILIO_WEBHOOK_PORT=8080

# --- invoices ---
BUSINESS_NAME=Your Business
