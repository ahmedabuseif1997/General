# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# --- brain (headless Claude Code) ---
# Override if you need to pin a model or add flags, e.g.:
# BRAIN_CMD=claude -p --output-format text --model claude-sonnet-5
BRAIN_CMD=claude -p --output-format text

# --- telegram surface + receipts delivery ---
# Create a bot via @BotFather, then run `python3 -m surfaces.telegram_bot`
# once and message it — it will print your chat id to fill in below.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- email actions (brain/emailer.py) ---
# Gmail: create an app password at https://myaccount.google.com/apppasswords
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
IMAP_HOST=imap.gmail.com

# --- phone line (calls/runner.py) ---
# stub = simulated line, you play the callee at the keyboard (default)
# twilio = real line — not wired yet, see surfaces/phone/twilio_adapter.py
PHONE_ADAPTER=stub

# --- invoices ---
BUSINESS_NAME=Your Business
